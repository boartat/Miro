+void
+DynamicSpareRegistry::setDevice(WMT::Device device) {
+  device_ = device;
+  Logger::info(str::format("miroe MUMA: memory budget ", budget() >> 20, " MB, idle spare limit ",
+       std::min(max_idle_bytes_, budget() / 8u) >> 20, " MB"));
+}
+
+uint64_t
+DynamicSpareRegistry::budget() {
+  if (budget_override_)
+    return budget_override_;
+  if (!device_.handle)
+    return ~0ull;
+  // DXVK (updateMemoryHeapBudgets): keep 1% of the heap, clamped to 4-256 MB, out of the budget
+  uint64_t working_set = device_.recommendedMaxWorkingSetSize();
+  uint64_t reserve = std::clamp<uint64_t>(working_set / 100u, 4ull << 20, kChunkSize);
+  return working_set > reserve ? working_set - reserve : working_set;
+}
+
+uint64_t
+DynamicSpareRegistry::freeIdleLocked(uint64_t coherent_seq_id, uint64_t bytes) {
+  uint64_t freed = 0;
+  for (auto it = holders_.begin(); it != holders_.end() && freed < bytes;) {
+    bool empty = false;
+    freed += (*it)->freeIdleSpares(coherent_seq_id, bytes - freed, empty);
+    if (empty)
+      it = holders_.erase(it);
+    else
+      ++it;
+  }
+  return freed;
+}
+
 void
 DynamicSpareRegistry::trim(uint64_t coherent_seq_id) {
-  auto now = now_ms();
+  SpareTrimContext ctx{
+      .coherent_seq_id = coherent_seq_id,
+      .now_ms = now_ms(),
+      .free_ms = free_ms_,
+      .purgeable = purgeable_,
+      .timed_free_allowance = kChunkSize,
+  };
   // lock order: registry, then holder. Holders register only after releasing their own lock.
   std::lock_guard<dxmt::mutex> lock(mutex_);
   for (auto it = holders_.begin(); it != holders_.end();) {
-    if ((*it)->trimSpares(coherent_seq_id, now, free_ms_, purgeable_))
+    if ((*it)->trimSpares(ctx))
       it = holders_.erase(it);
     else
       ++it;
   }
+  if (!ctx.idle_bytes)
+    return;
+  // DXVK (freeEmptyChunksInPool): bound unused memory, scaled down when the budget is small, and free all of
+  // it when the device is over budget
+  uint64_t limit = std::min(max_idle_bytes_, budget() / 8u);
+  uint64_t excess = ctx.idle_bytes > limit ? ctx.idle_bytes - limit : 0;
+  if (device_.handle && device_.currentAllocatedSize() > budget())
+    excess = ctx.idle_bytes;
+  if (excess)
+    freeIdleLocked(coherent_seq_id, excess);
+}
+
+void
+DynamicSpareRegistry::makeRoom(uint64_t coherent_seq_id, uint64_t bytes) {
+  if (!device_.handle)
+    return;
+  uint64_t limit = budget(), allocated = device_.currentAllocatedSize();
+  if (allocated + bytes <= limit)
+    return;
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  freeIdleLocked(coherent_seq_id, allocated + bytes - limit);
 }
 
