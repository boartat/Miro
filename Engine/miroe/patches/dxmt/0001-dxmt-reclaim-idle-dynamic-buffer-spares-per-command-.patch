 namespace dxmt {
-DynamicBuffer::DynamicBuffer(Buffer *buffer, Flags<BufferAllocationFlag> flags) :
+DynamicBuffer::DynamicBuffer(Buffer *buffer, Flags<BufferAllocationFlag> flags, DynamicSpareRegistry *spares) :
     buffer(buffer),
     flags_(flags),
-    name_(buffer->current()) {}
+    name_(buffer->current()),
+    spares_(spares) {}
+
+DynamicBuffer::~DynamicBuffer() {
+  if (spares_)
+    spares_->remove(this);
+}
+
+void
+DynamicBuffer::registerSpares() {
+  if (spares_)
+    spares_->add(this);
+}
+
+bool
+DynamicBuffer::trimSpares(uint64_t coherent_seq_id) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  while (!fifo.empty() && fifo.front().will_free_at + DynamicSpareRegistry::kSpareLifetime < coherent_seq_id)
+    fifo.pop();
+  return fifo.empty();
+}
+
+void
+DynamicSpareRegistry::add(DynamicBuffer *buffer) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  if (!buffer->registered_) {
+    buffers_.insert(buffer);
+    buffer->registered_ = true;
+  }
+}
+
+void
+DynamicSpareRegistry::remove(DynamicBuffer *buffer) {
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  if (buffer->registered_) {
+    buffers_.erase(buffer);
+    buffer->registered_ = false;
+  }
+}
+
+void
+DynamicSpareRegistry::trim(uint64_t coherent_seq_id) {
+  // lock order: registry, then buffer. Buffers register only after releasing their own lock.
+  std::lock_guard<dxmt::mutex> lock(mutex_);
+  for (auto it = buffers_.begin(); it != buffers_.end();) {
+    if ((*it)->trimSpares(coherent_seq_id)) {
+      (*it)->registered_ = false;
+      it = buffers_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
 
