new file mode 100644
index 0000000..e079ba1
--- /dev/null
+++ b/src/dxmt/dxmt_dynamic_spares.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "thread.hpp"
+#include <cstdint>
+#include <unordered_set>
+
+namespace dxmt {
+
+class DynamicBuffer;
+
+/**
+ * miroe MUMA v0: the dynamic buffers of one command queue that hold spare (renamed-away) allocations.
+ *
+ * WRITE_DISCARD renames a dynamic buffer to a fresh allocation while the GPU still reads the old one; the old
+ * one is queued as a spare for reuse. Without trimming, the spares of a burst stay allocated for the life of
+ * the buffer, and a buffer that is no longer mapped never gets to drop them (DXMT issue #260). The command
+ * queue's finish thread calls trim() with its coherent sequence id, so spares the GPU has been done with for
+ * a while are freed even when their buffer stays idle. Sequence ids are per queue, so is the registry.
+ */
+class DynamicSpareRegistry {
+public:
+  /** Spares unused for this many submissions are freed */
+  static constexpr uint64_t kSpareLifetime = 300;
+
+  void add(DynamicBuffer *buffer);
+  void remove(DynamicBuffer *buffer);
+  void trim(uint64_t coherent_seq_id);
+
+private:
+  dxmt::mutex mutex_;
+  std::unordered_set<DynamicBuffer *> buffers_;
+};
+
+} // namespace dxmt
