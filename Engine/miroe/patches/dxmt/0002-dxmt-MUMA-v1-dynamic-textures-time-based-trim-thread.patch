diff --git a/src/dxmt/dxmt_dynamic_spares.hpp b/src/dxmt/dxmt_dynamic_spares.hpp
index e079ba1..045deda 100644
--- a/src/dxmt/dxmt_dynamic_spares.hpp
+++ b/src/dxmt/dxmt_dynamic_spares.hpp
@@ -1,34 +1,89 @@
 #pragma once
 
 #include "thread.hpp"
+#include <atomic>
 #include <cstdint>
 #include <unordered_set>
 
 namespace dxmt {
 
-class DynamicBuffer;
+class DynamicSpareRegistry;
 
 /**
- * miroe MUMA v0: the dynamic buffers of one command queue that hold spare (renamed-away) allocations.
+ * miroe MUMA v1: a dynamic buffer or texture that keeps spare (renamed-away) allocations.
  *
- * WRITE_DISCARD renames a dynamic buffer to a fresh allocation while the GPU still reads the old one; the old
- * one is queued as a spare for reuse. Without trimming, the spares of a burst stay allocated for the life of
- * the buffer, and a buffer that is no longer mapped never gets to drop them (DXMT issue #260). The command
- * queue's finish thread calls trim() with its coherent sequence id, so spares the GPU has been done with for
- * a while are freed even when their buffer stays idle. Sequence ids are per queue, so is the registry.
+ * WRITE_DISCARD renames a dynamic resource to a fresh allocation while the GPU still reads the old one; the
+ * old one is queued as a spare for reuse. Without trimming, the spares of a burst stay allocated for the
+ * life of the resource, and a resource that is no longer mapped never drops them (DXMT issue #260).
+ */
+class DynamicSpareHolder {
+public:
+  /**
+   * Called by the registry with its lock held. Frees spares the GPU is done with that have waited at least
+   * kSpareFreeMs, and marks large ones purgeable. Returns true when no spare is left; the holder then clears
+   * its registration under its own lock (see markUnregistered).
+   */
+  virtual bool trimSpares(uint64_t coherent_seq_id, uint64_t now_ms, uint64_t free_ms, bool purgeable) = 0;
+
+protected:
+  ~DynamicSpareHolder() = default;
+  /** With the holder's lock held and its spare queue empty */
+  void
+  markUnregistered() {
+    registered_.store(false, std::memory_order_release);
+  }
+
+private:
+  friend class DynamicSpareRegistry;
+  std::atomic<bool> registered_ = false;
+};
+
+/**
+ * The holders of one command queue (sequence ids are per queue). A thread of the queue calls trim() every
+ * 250 ms, so spares come back even when the application stops submitting.
  */
 class DynamicSpareRegistry {
 public:
-  /** Spares unused for this many submissions are freed */
-  static constexpr uint64_t kSpareLifetime = 300;
+  /** A spare the GPU is done with is freed after waiting this long (MIROE_MUMA_FREE_MS overrides) */
+  static constexpr uint64_t kSpareFreeMs = 2000;
+
+  DynamicSpareRegistry();
+  /** Spares at least this large are marked purgeable as soon as the GPU is done with them */
+  static constexpr uint64_t kPurgeableMinSize = 1u << 20;
+
+  /**
+   * After a holder queued a spare, outside the holder's lock. Lock-free when already registered: trim clears
+   * the flag under the holder's lock only when the queue is empty, so a spare queued after that sees it
+   * cleared and registers again.
+   */
+  void
+  add(DynamicSpareHolder *holder) {
+    if (holder->registered_.load(std::memory_order_acquire))
+      return;
+    std::lock_guard<dxmt::mutex> lock(mutex_);
+    if (!holder->registered_.load(std::memory_order_relaxed)) {
+      holders_.insert(holder);
+      holder->registered_.store(true, std::memory_order_release);
+    }
+  }
+
+  void
+  remove(DynamicSpareHolder *holder) {
+    std::lock_guard<dxmt::mutex> lock(mutex_);
+    if (holders_.erase(holder))
+      holder->registered_.store(false, std::memory_order_release);
+  }
 
-  void add(DynamicBuffer *buffer);
-  void remove(DynamicBuffer *buffer);
   void trim(uint64_t coherent_seq_id);
 
+  static uint64_t now_ms();
+
 private:
   dxmt::mutex mutex_;
-  std::unordered_set<DynamicBuffer *> buffers_;
+  std::unordered_set<DynamicSpareHolder *> holders_;
+  uint64_t free_ms_ = kSpareFreeMs;
+  /** MIROE_MUMA_PURGEABLE=0 turns purgeable spares off (for measurements) */
+  bool purgeable_ = true;
 };
 
 } // namespace dxmt
