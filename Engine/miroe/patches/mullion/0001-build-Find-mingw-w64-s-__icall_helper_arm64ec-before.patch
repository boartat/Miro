From 832cb0b5fb8faa82e1e4948434fb96c600bc8140 Mon Sep 17 00:00:00 2001
From: miroe <260228444+boartat@users.noreply.github.com>
Date: Fri, 27 Nov 2026 12:57:44 +0900
Subject: [PATCH 1/2] build: Find mingw-w64's __icall_helper_arm64ec before
 winecrt0's (from Hadron dxmt 0003)


Taken unchanged from Hadron's patches/dxmt/0003 (https://github.com/Broyojo/hadron,
commit 17aa4d6c), which fixes the same link failure in DXMT's ARM64X build.
Copyright (c) 2026 David Andrews. Hadron's patches carry the license of the project
they modify: LGPL-2.1-or-later, like DXMT and Mullion.
---
 build-arm64ec.txt | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/build-arm64ec.txt b/build-arm64ec.txt
index e9ac3b4..113cb52 100644
--- a/build-arm64ec.txt
+++ b/build-arm64ec.txt
@@ -11,8 +11,11 @@ needs_exe_wrapper = true
 [built-in options]
 c_args = ['-marm64x']
 cpp_args = ['-marm64x']
-c_link_args = ['-marm64x']
-cpp_link_args = ['-marm64x']
+# -lmingwex: mingw-w64's chpe.o has the CHPE metadata and __icall_helper_arm64ec. Since Wine
+# 11.21 winecrt0 has its own __icall_helper_arm64ec (winebuild makes the metadata), and
+# winemetal links winecrt0, so the two collide unless mingw-w64's is found first.
+c_link_args = ['-marm64x', '-lmingwex']
+cpp_link_args = ['-marm64x', '-lmingwex']
 
 [host_machine]
 system = 'windows'
-- 
