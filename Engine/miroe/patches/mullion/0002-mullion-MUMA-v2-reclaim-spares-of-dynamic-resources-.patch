+void
+BufferAllocation::setPurgeableSpare(bool spare) {
+  // MIROE_MUMA_KEEP_HEARTBEAT=1 leaves spares in the heartbeat's set, to measure what that costs
+  static const bool keep_in_heartbeat = env::getEnvVar("MIROE_MUMA_KEEP_HEARTBEAT") == "1";
+  if (spare) {
+    if (kept_ && !keep_in_heartbeat) {
+      heartbeat::Release(obj_);
+      kept_ = false;
+    }
+    obj_.setPurgeableState(WMTPurgeableStateVolatile);
+  } else {
+    obj_.setPurgeableState(WMTPurgeableStateNonVolatile);
+    if (!kept_)
+      kept_ = heartbeat::Keep(obj_, info_.length);
+  }
+}
