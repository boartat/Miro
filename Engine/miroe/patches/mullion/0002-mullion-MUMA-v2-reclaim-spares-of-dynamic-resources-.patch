diff --git a/src/mullion/mullion_dynamic_spares.hpp b/src/mullion/mullion_dynamic_spares.hpp
new file mode 100644
index 0000000..bd5b9c4
--- /dev/null
+++ b/src/mullion/mullion_dynamic_spares.hpp
@@ -0,0 +1,141 @@
+#pragma once
+
+#include "Metal.hpp"
+#include "thread.hpp"
+#include <atomic>
+#include <cstdint>
+#include <unordered_set>
+
+namespace mullion {
+
+class DynamicSpareRegistry;
+
+/**
+ * miroe MUMA: what one trim pass knows and collects.
+ */
+struct SpareTrimContext {
+  uint64_t coherent_seq_id;
+  uint64_t now_ms;
+  /** A spare the GPU is done with is freed after waiting this long */
+  uint64_t free_ms;
+  bool purgeable;
+  /** Bytes the time rule may still free in this pass (DXVK frees at most one chunk per pass) */
+  uint64_t timed_free_allowance;
+  /** Out: bytes of spares the GPU is done with that are still held after the time rule */
+  uint64_t idle_bytes = 0;
+};
+
+/**
+ * miroe MUMA: a dynamic buffer or texture that keeps spare (renamed-away) allocations.
+ *
+ * WRITE_DISCARD renames a dynamic resource to a fresh allocation while the GPU still reads the old one; the
+ * old one is queued as a spare for reuse. Without trimming, the spares of a burst stay allocated for the
+ * life of the resource, and a resource that is no longer mapped never drops them (DXMT issue #260).
+ */
+class DynamicSpareHolder {
+public:
+  /**
+   * Called by the registry with its lock held. Applies the time rule, marks large spares purgeable and adds
+   * the bytes of idle spares (GPU done) to ctx.idle_bytes. Returns true when no spare is left; the holder
+   * then clears its registration under its own lock (see markUnregistered).
+   */
+  virtual bool trimSpares(SpareTrimContext &ctx) = 0;
+
+  /**
+   * Called by the registry with its lock held. Frees idle spares, oldest first, until at least `bytes` are
+   * freed or none is left; sets `empty` (and clears the registration) when no spare is left.
+   */
+  virtual uint64_t freeIdleSpares(uint64_t coherent_seq_id, uint64_t bytes, bool &empty) = 0;
+
+protected:
+  ~DynamicSpareHolder() = default;
+  /** With the holder's lock held and its spare queue empty */
+  void
+  markUnregistered() {
+    registered_.store(false, std::memory_order_release);
+  }
+
+private:
+  friend class DynamicSpareRegistry;
+  std::atomic<bool> registered_ = false;
+};
+
+/**
+ * The holders of one command queue (sequence ids are per queue). A thread of the queue calls trim() every
+ * 250 ms, independent of submissions, so spares come back even when the application stops submitting.
+ *
+ * Besides MUMA's own rules (time rule, purgeable spares) the pass follows DXVK's memory allocator
+ * (src/dxvk/dxvk_memory.cpp, zlib license, https://github.com/doitsujin/dxvk):
+ *  - a limit on unused memory, past which idle spares are freed regardless of age
+ *    (freeEmptyChunksInPool: 4 max-size chunks for mapped memory), scaled down for small Metal budgets;
+ *  - a memory budget (updateMemoryHeapBudgets), with idle spares freed before an allocation that would exceed
+ *    it. On Mullion the budget is Mullion's own memory::Budget: 95% of the Metal working set, lowered as macOS
+ *    memory pressure rises (src/mullion/mullion_memory.hpp), so spares go first when the system runs short;
+ *  - the time rule frees at most one max-size chunk worth of memory per pass.
+ */
+class DynamicSpareRegistry {
+public:
+  /** MUMA: a spare the GPU is done with is freed after waiting this long (MIROE_MUMA_FREE_MS overrides) */
+  static constexpr uint64_t kSpareFreeMs = 2000;
+  /** MUMA: spares at least this large are marked purgeable as soon as the GPU is done with them */
+  static constexpr uint64_t kPurgeableMinSize = 1u << 20;
+  /** DXVK's maximum chunk size: the time rule frees at most this much per pass */
+  static constexpr uint64_t kChunkSize = 256ull << 20;
+  /** DXVK keeps at most 4 unused max-size chunks of mapped memory (MIROE_MUMA_MAX_IDLE_MB overrides) */
+  static constexpr uint64_t kMaxIdleBytes = 4 * kChunkSize;
+
+  DynamicSpareRegistry();
+
+  /** The Metal device whose working set is the budget */
+  void setDevice(WMT::Device device);
+
+  /**
+   * After a holder queued a spare, outside the holder's lock. Lock-free when already registered: trim clears
+   * the flag under the holder's lock only when the queue is empty, so a spare queued after that sees it
+   * cleared and registers again.
+   */
+  void
+  add(DynamicSpareHolder *holder) {
+    if (holder->registered_.load(std::memory_order_acquire))
+      return;
+    std::lock_guard<mullion::mutex> lock(mutex_);
+    if (!holder->registered_.load(std::memory_order_relaxed)) {
+      holders_.insert(holder);
+      holder->registered_.store(true, std::memory_order_release);
+    }
+  }
+
+  void
+  remove(DynamicSpareHolder *holder) {
+    std::lock_guard<mullion::mutex> lock(mutex_);
+    if (holders_.erase(holder))
+      holder->registered_.store(false, std::memory_order_release);
+  }
+
+  /** The periodic pass */
+  void trim(uint64_t coherent_seq_id);
+
+  /**
+   * Before a new allocation of `bytes`, outside any holder lock: if it would exceed the budget, frees idle
+   * spares first (DXVK frees unused memory before an allocation that would exceed the heap budget).
+   */
+  void makeRoom(uint64_t coherent_seq_id, uint64_t bytes);
+
+  static uint64_t now_ms();
+
+private:
+  uint64_t budget();
+  uint64_t freeIdleLocked(uint64_t coherent_seq_id, uint64_t bytes);
+
+  mullion::mutex mutex_;
+  std::unordered_set<DynamicSpareHolder *> holders_;
+  WMT::Device device_;
+  uint64_t free_ms_ = kSpareFreeMs;
+  uint64_t max_idle_bytes_ = kMaxIdleBytes;
+  /** 0: Mullion's memory::Budget. MIROE_MUMA_BUDGET_MB sets it, e.g. to act like a smaller Mac */
+  uint64_t budget_override_ = 0;
+  /** MIROE_MUMA_PURGEABLE=0 turns purgeable spares off (for measurements) */
+  bool purgeable_ = true;
+};
+
+} // namespace mullion
