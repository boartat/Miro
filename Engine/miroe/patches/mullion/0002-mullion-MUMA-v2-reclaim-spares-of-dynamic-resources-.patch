+  for (auto &entry : fifo) {
+    if (entry.will_free_at > ctx.coherent_seq_id)
+      break;
+    ctx.idle_bytes += size_;
+  }
+  if (!fifo.empty())
+    return false;
+  markUnregistered();
+  return true;
+}
