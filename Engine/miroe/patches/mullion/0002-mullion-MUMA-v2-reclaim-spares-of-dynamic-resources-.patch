+
+uint64_t
+DynamicSpareRegistry::budget() {
+  if (budget_override_)
+    return budget_override_;
+  if (!device_.handle)
+    return ~0ull;
+  // Mullion's budget: 95% of the working set, lower under macOS memory pressure (DXVK's updateMemoryHeapBudgets
+  // keeps a reserve of the heap out of its budget in the same way)
+  return memory::Budget(device_);
+}
+
+uint64_t
+DynamicSpareRegistry::freeIdleLocked(uint64_t coherent_seq_id, uint64_t bytes) {
+  uint64_t freed = 0;
+  for (auto it = holders_.begin(); it != holders_.end() && freed < bytes;) {
+    bool empty = false;
+    freed += (*it)->freeIdleSpares(coherent_seq_id, bytes - freed, empty);
+    if (empty)
+      it = holders_.erase(it);
+    else
+      ++it;
+  }
+  return freed;
+}
+
+void
+DynamicSpareRegistry::trim(uint64_t coherent_seq_id) {
+  SpareTrimContext ctx{
+      .coherent_seq_id = coherent_seq_id,
+      .now_ms = now_ms(),
+      .free_ms = free_ms_,
+      .purgeable = purgeable_,
+      .timed_free_allowance = kChunkSize,
+  };
+  // lock order: registry, then holder. Holders register only after releasing their own lock.
+  std::lock_guard<mullion::mutex> lock(mutex_);
+  for (auto it = holders_.begin(); it != holders_.end();) {
+    if ((*it)->trimSpares(ctx))
+      it = holders_.erase(it);
+    else
+      ++it;
+  }
+  if (!ctx.idle_bytes)
+    return;
+  // DXVK (freeEmptyChunksInPool): bound unused memory, scaled down when the budget is small, and free all of
+  // it when the device is over budget
+  uint64_t limit = std::min(max_idle_bytes_, budget() / 8u);
+  uint64_t excess = ctx.idle_bytes > limit ? ctx.idle_bytes - limit : 0;
+  if (device_.handle && device_.currentAllocatedSize() > budget())
+    excess = ctx.idle_bytes;
+  if (excess)
+    freeIdleLocked(coherent_seq_id, excess);
+}
+
+void
+DynamicSpareRegistry::makeRoom(uint64_t coherent_seq_id, uint64_t bytes) {
+  if (!device_.handle)
+    return;
+  uint64_t limit = budget(), allocated = device_.currentAllocatedSize();
+  if (allocated + bytes <= limit)
+    return;
+  std::lock_guard<mullion::mutex> lock(mutex_);
+  freeIdleLocked(coherent_seq_id, allocated + bytes - limit);
+}
+
+DynamicBuffer::DynamicBuffer(Buffer *buffer, Flags<BufferAllocationFlag> flags, DynamicSpareRegistry *spares) :
     buffer(buffer),
     flags_(flags),
-    name_(buffer->current()) {}
+    name_(buffer->current()),
+    spares_(spares) {
+  // DXMT and Mullion flag dynamic buffers SuballocateFromOnePage; a spare is purgeable by its whole allocation,
+  // whatever names it holds, since it is queued only when none of them is in use
+  purgeable_spares_ = buffer->length() >= DynamicSpareRegistry::kPurgeableMinSize &&
+                      !flags.test(BufferAllocationFlag::CpuPlaced);
+}
+
+DynamicBuffer::~DynamicBuffer() {
+  if (spares_)
+    spares_->remove(this);
+}
+
+bool
+DynamicBuffer::trimSpares(SpareTrimContext &ctx) {
+  std::lock_guard<mullion::mutex> lock(mutex_);
+  // the queue is in submission order: once an entry is still in use, so are the ones after it. On Mullion an
+  // allocation may hold several names, so its bytes are its own, not the buffer's
+  while (!fifo.empty() && ctx.timed_free_allowance && fifo.front().will_free_at <= ctx.coherent_seq_id &&
+         ctx.now_ms - fifo.front().queued_ms >= ctx.free_ms) {
+    ctx.timed_free_allowance -= std::min(ctx.timed_free_allowance, fifo.front().allocation->allocatedLength());
+    fifo.pop_front();
+  }
+  for (auto &entry : fifo) {
+    if (entry.will_free_at > ctx.coherent_seq_id)
+      break;
+    ctx.idle_bytes += entry.allocation->allocatedLength();
+    if (ctx.purgeable && purgeable_spares_ && !entry.purgeable) {
+      // a discard never reads old contents, so the system may take the memory back at any time
+      entry.allocation->setPurgeableSpare(true);
+      entry.purgeable = true;
+    }
+  }
+  if (!fifo.empty())
+    return false;
+  markUnregistered();
+  return true;
+}
+
+uint64_t
+DynamicBuffer::freeIdleSpares(uint64_t coherent_seq_id, uint64_t bytes, bool &empty) {
+  std::lock_guard<mullion::mutex> lock(mutex_);
+  uint64_t freed = 0;
+  while (!fifo.empty() && freed < bytes && fifo.front().will_free_at <= coherent_seq_id) {
+    freed += fifo.front().allocation->allocatedLength();
+    fifo.pop_front();
+  }
+  if ((empty = fifo.empty()))
+    markUnregistered();
+  return freed;
+}
 
