+  while (!fifo.empty() && ctx.timed_free_allowance && fifo.front().will_free_at <= ctx.coherent_seq_id &&
+         ctx.now_ms - fifo.front().queued_ms >= ctx.free_ms) {
+    fifo.pop_front();
+    ctx.timed_free_allowance -= std::min(ctx.timed_free_allowance, size_);
