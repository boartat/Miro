+/*
+ * DXMT (https://github.com/3Shain/dxmt) renders Direct3D 10/11 with Metal. Its Unix library asks the
+ * Mac driver for a Metal view on a window through an exported `macdrv_functions` table, the interface
+ * CrossOver provides. That table hands out the driver's window data and DXMT reads the first four
+ * fields of it, laid out as { hwnd, cocoa_window, cocoa_view, client_cocoa_view }.
+ *
+ * This driver keeps neither that layout nor a permanent client view: Vulkan and OpenGL draw into
+ * client surfaces instead. So the table exported here does not expose the real window data. Each
+ * get_win_data() call creates a client surface for the window, exactly like the Vulkan path does, and
+ * returns a small record in the layout DXMT expects that points at the surface's view. DXMT then puts
+ * its Metal view inside that view, the same way MetalViewSwapChain does for Vulkan.
+ *
+ * Unlike Vulkan, DXMT presents straight to its CAMetalLayer and never calls back into the driver, so
+ * nothing else would keep the view visible and positioned. Surfaces that carry a DXMT view are therefore
+ * re-presented whenever their window moves (macdrv_dxmt_window_pos_changed), and the window surface
+ * flush leaves them visible (macdrv_dxmt_owns_view). The surface is released together with the view.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dispatch/dispatch.h>
+
+#include "macdrv.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+/* The part of CrossOver's struct macdrv_win_data that DXMT reads, followed by our own field */
+struct dxmt_win_data
+{
+    HWND                  hwnd;
+    WineWindow           *cocoa_window;
+    WineContentView      *cocoa_view;
+    WineContentView      *client_cocoa_view;
+    struct dxmt_surface  *surface;
+};
+
+/* A client surface handed to DXMT, and the Metal view DXMT created in it */
+struct dxmt_surface
+{
+    struct list            entry;
+    HWND                   toplevel;
+    struct client_surface *client;
+    WineContentView       *view;
+    WineMetalView         *metal_view;
+};
+
+/* Same order as CrossOver's table; DXMT reads fields by position */
+struct macdrv_functions_t
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    MTLDevice_id (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(MTLDevice_id device);
+    WineMetalView *(*macdrv_view_create_metal_view)(WineContentView *view, MTLDevice_id device);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *view);
+    void (*macdrv_view_release_metal_view)(WineMetalView *view);
+    void (*on_main_thread)(dispatch_block_t block);
+};
+
+static pthread_mutex_t dxmt_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct list dxmt_surfaces = LIST_INIT(dxmt_surfaces);
+
+/* Returned when there is nothing to draw into; DXMT does not check for NULL */
+static struct dxmt_win_data no_window;
+
+
+static void dxmt_surface_free(struct dxmt_surface *surface)
+{
+    client_surface_release(surface->client);
+    free(surface);
+}
+
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct dxmt_win_data *ret;
+    struct dxmt_surface *surface;
+    struct client_surface *client;
+    WineWindow *cocoa_window;
+
+    /* Only windows of this process have a Cocoa window to put a view in */
+    if (!(data = get_win_data(hwnd))) return &no_window;
+    cocoa_window = data->cocoa_window;
+    release_win_data(data);
+
+    if (!(ret = calloc(1, sizeof(*ret)))) return &no_window;
+    ret->hwnd = hwnd;
+    ret->cocoa_window = cocoa_window;
+
+    if (!(surface = calloc(1, sizeof(*surface))) || !(client = macdrv_CreateClientSurface(hwnd, 0, FALSE)))
+    {
+        free(surface);
+        return ret;
+    }
+    surface->client = client;
+    surface->toplevel = client->toplevel;
+    surface->view = impl_from_client_surface(client)->cocoa_view;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    list_add_tail(&dxmt_surfaces, &surface->entry);
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    ret->cocoa_view = ret->client_cocoa_view = surface->view;
+    ret->surface = surface;
+    TRACE("hwnd %p view %p\n", hwnd, surface->view);
+    return ret;
+}
+
+
+static void dxmt_release_win_data(struct dxmt_win_data *data)
+{
+    struct dxmt_surface *surface;
+    BOOL unused = FALSE;
+
+    if (!data || data == &no_window) return;
+
+    /* A surface that did not get a Metal view is not needed any more */
+    if ((surface = data->surface))
+    {
+        pthread_mutex_lock(&dxmt_mutex);
+        if ((unused = !surface->metal_view)) list_remove(&surface->entry);
+        pthread_mutex_unlock(&dxmt_mutex);
+        if (unused) dxmt_surface_free(surface);
+    }
+    free(data);
+}
+
+
+static WineWindow *dxmt_get_cocoa_window(HWND hwnd, BOOL require_on_screen)
+{
+    return macdrv_get_cocoa_window(hwnd, !!require_on_screen);
+}
+
+
+static WineMetalView *dxmt_view_create_metal_view(WineContentView *view, MTLDevice_id device)
+{
+    struct dxmt_surface *surface;
+    WineMetalView *metal_view;
+
+    if (!view || !(metal_view = macdrv_view_create_metal_view(view, device))) return NULL;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &dxmt_surfaces, struct dxmt_surface, entry)
+    {
+        if (surface->view != view || surface->metal_view) continue;
+        surface->metal_view = metal_view;
+        break;
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    TRACE("view %p metal view %p\n", view, metal_view);
+    return metal_view;
+}
+
+
+static void dxmt_view_release_metal_view(WineMetalView *metal_view)
+{
+    struct dxmt_surface *surface, *found = NULL;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &dxmt_surfaces, struct dxmt_surface, entry)
+    {
+        if (surface->metal_view != metal_view) continue;
+        list_remove(&surface->entry);
+        found = surface;
+        break;
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    TRACE("metal view %p\n", metal_view);
+    macdrv_view_release_metal_view(metal_view);
+    if (found) dxmt_surface_free(found);
+}
+
+
+__attribute__((visibility("default"))) const struct macdrv_functions_t macdrv_functions =
+{
+    .macdrv_init_display_devices = NULL,
+    .get_win_data = dxmt_get_win_data,
+    .release_win_data = dxmt_release_win_data,
+    .macdrv_get_cocoa_window = dxmt_get_cocoa_window,
+    .macdrv_create_metal_device = macdrv_create_metal_device,
+    .macdrv_release_metal_device = macdrv_release_metal_device,
+    .macdrv_view_create_metal_view = dxmt_view_create_metal_view,
+    .macdrv_view_get_metal_layer = macdrv_view_get_metal_layer,
+    .macdrv_view_release_metal_view = dxmt_view_release_metal_view,
+    .on_main_thread = NULL,
+};
+
+
+/***********************************************************************
+ *              macdrv_dxmt_owns_view
+ *
+ * Whether a client view carries a DXMT Metal view. Called with the window data locked.
+ */
+bool macdrv_dxmt_owns_view(WineContentView *view)
+{
+    struct dxmt_surface *surface;
+    bool ret = false;
+
+    if (!view) return false;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &dxmt_surfaces, struct dxmt_surface, entry)
+    {
+        if (surface->view != view || !surface->metal_view) continue;
+        ret = true;
+        break;
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    return ret;
+}
+
+
+/***********************************************************************
+ *              macdrv_dxmt_window_pos_changed
+ *
+ * Moves and shows the DXMT views of a toplevel window after it changed. Called without locks held.
+ */
+void macdrv_dxmt_window_pos_changed(HWND hwnd)
+{
+    struct client_surface *clients[8];
+    struct dxmt_surface *surface;
+    UINT i, count = 0;
+
+    pthread_mutex_lock(&dxmt_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &dxmt_surfaces, struct dxmt_surface, entry)
+    {
+        if (surface->toplevel != hwnd || !surface->metal_view) continue;
+        client_surface_add_ref(surface->client);
+        clients[count++] = surface->client;
+        if (count == ARRAY_SIZE(clients)) break;
+    }
+    pthread_mutex_unlock(&dxmt_mutex);
+
+    for (i = 0; i < count; i++)
+    {
+        client_surface_present(clients[i]);
+        client_surface_release(clients[i]);
+    }
+}
